# Runtime reports (generated by pipeline) — anchored to repo root so
# versioned snapshots under release_notes/<ver>/reports/ stay tracked.
/reports/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pip_cache/
dist/
build/

# HyperExecute binary (downloaded at runtime)
hyperexecute
hyperexecute.exe

# Kane CLI sessions and test artifacts
.testmuai/
.testmu/
screenshots/

# Kane testmd per-machine replay cache (created by `kane-cli testmd run`).
# Except .internal/meta.json: it ties the asset to its Test Manager case, so a
# replay reuses that case instead of creating a new one.
tests/kane/**/output-*/*
!tests/kane/**/output-*/.internal/
tests/kane/**/output-*/.internal/*
!tests/kane/**/output-*/.internal/meta.json

# Kane Playwright code-export cache (regenerated each run from _test.md replays)
tests/playwright/exported/

# HyperExecute runtime artifacts
.hyperexecute/
hyperexecute-cli.log

# Pipeline artifact cache
.gh-artifacts/

# Ollama Modelfile (generated at runtime)
Modelfile

# Misc local files
search.txt

# IDE
.vscode/
.idea/
.claude/

# OS
.DS_Store
Thumbs.db

# Secrets
.env
.env.local
.updatedhyperexecute.yaml

# Staged native testmu exports (regenerated by Stage 3)
tests/playwright/native/sc_*/
tests/playwright/native/requirements.txt

# per-run copy written by tests/playwright/native/run_with_junit.py
.session_test.py
